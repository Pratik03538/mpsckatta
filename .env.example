# Copy this file to .env and add your Google AI Studio API key.
# Do not commit .env to GitHub.
GEMINI_API_KEY=PASTE_YOUR_KEY_HERE

# Main and fallback models. Model availability and quotas can change.
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.6-flash

# Reasoning depth: minimal, low, medium, high.
# Notes and PYQ research default to high; visuals and practice questions use medium.
GEMINI_THINKING_LEVEL=high
GEMINI_AUX_THINKING_LEVEL=medium