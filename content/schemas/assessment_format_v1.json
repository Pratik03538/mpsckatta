{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MPSC Katta Assessment & Test Series Data Schema",
  "version": "1.1",
  "description": "Stable machine-readable format for student-facing practice MCQs, verified official PYQs, MPSC topic tests and reference-based test series.",
  "$defs": {
    "options": {
      "type": "object",
      "required": [
        "A",
        "B",
        "C",
        "D"
      ],
      "properties": {
        "A": {
          "type": "string"
        },
        "B": {
          "type": "string"
        },
        "C": {
          "type": "string"
        },
        "D": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "mcqItem": {
      "type": "object",
      "required": [
        "question_id",
        "question_no",
        "question",
        "options",
        "correct_option",
        "answer",
        "explanation",
        "source_status",
        "student_forwardable"
      ],
      "properties": {
        "question_id": {
          "type": "string",
          "pattern": "^HIS-[0-9]{3}-MCQ-[0-9]{3}$"
        },
        "question_no": {
          "type": "integer",
          "minimum": 1
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "options": {
          "$ref": "#/$defs/options"
        },
        "correct_option": {
          "type": "string",
          "enum": [
            "A",
            "B",
            "C",
            "D"
          ]
        },
        "answer": {
          "type": "string",
          "minLength": 1
        },
        "explanation": {
          "type": "string",
          "minLength": 1
        },
        "source_status": {
          "const": "author_created_practice_not_pyq"
        },
        "student_forwardable": {
          "const": true
        }
      },
      "additionalProperties": false
    },
    "mcqDocument": {
      "type": "object",
      "required": [
        "schema_version",
        "topic_id",
        "topic_title",
        "language",
        "content_type",
        "question_count",
        "answer_key_included",
        "items"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "topic_id": {
          "type": "string",
          "pattern": "^HIS-[0-9]{3}$"
        },
        "topic_title": {
          "type": "string"
        },
        "language": {
          "const": "mr"
        },
        "content_type": {
          "const": "practice_mcq"
        },
        "question_count": {
          "type": "integer",
          "minimum": 1
        },
        "answer_key_included": {
          "const": true
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/mcqItem"
          }
        }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": [
        "label",
        "url",
        "source_type"
      ],
      "properties": {
        "label": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "source_type": {
          "type": "string",
          "enum": [
            "official_original_paper",
            "official_final_answer_key",
            "third_party_archive",
            "other"
          ]
        }
      },
      "additionalProperties": false
    },
    "pyqItem": {
      "type": "object",
      "required": [
        "question_id",
        "question_no",
        "original_question_no",
        "exam",
        "year",
        "paper",
        "question",
        "options",
        "correct_option",
        "answer",
        "explanation",
        "source",
        "verification_status",
        "official_paper_verified",
        "official_final_answer_key_verified",
        "student_forwardable"
      ],
      "properties": {
        "question_id": {
          "type": "string",
          "pattern": "^HIS-[0-9]{3}-PYQ-[0-9]{3}$"
        },
        "question_no": {
          "type": "integer",
          "minimum": 1
        },
        "original_question_no": {
          "type": "string"
        },
        "exam": {
          "type": "string"
        },
        "year": {
          "type": "integer"
        },
        "paper": {
          "type": "string"
        },
        "question": {
          "type": "string"
        },
        "options": {
          "$ref": "#/$defs/options"
        },
        "correct_option": {
          "type": "string",
          "enum": [
            "A",
            "B",
            "C",
            "D"
          ]
        },
        "answer": {
          "type": "string"
        },
        "explanation": {
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "verification_status": {
          "type": "string",
          "enum": [
            "verified",
            "unverified_third_party_transcription",
            "pending",
            "rejected"
          ]
        },
        "official_paper_verified": {
          "type": "boolean"
        },
        "official_final_answer_key_verified": {
          "type": "boolean"
        },
        "student_forwardable": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "questionPattern": {
      "type": "object",
      "required": [
        "pattern_id",
        "pattern_no",
        "prompt",
        "is_pyq",
        "student_forwardable"
      ],
      "properties": {
        "pattern_id": {
          "type": "string"
        },
        "pattern_no": {
          "type": "integer",
          "minimum": 1
        },
        "prompt": {
          "type": "string"
        },
        "is_pyq": {
          "const": false
        },
        "student_forwardable": {
          "const": true
        }
      },
      "additionalProperties": false
    },
    "pyqDocument": {
      "type": "object",
      "required": [
        "schema_version",
        "topic_id",
        "topic_title",
        "language",
        "content_type",
        "forward_policy",
        "verified_items",
        "unverified_candidates",
        "question_patterns"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "topic_id": {
          "type": "string",
          "pattern": "^HIS-[0-9]{3}$"
        },
        "topic_title": {
          "type": "string"
        },
        "language": {
          "const": "mr"
        },
        "content_type": {
          "const": "pyq"
        },
        "forward_policy": {
          "type": "object",
          "required": [
            "only_verified_items_may_be_forwarded",
            "required_verification",
            "unverified_candidates_forward_allowed"
          ],
          "properties": {
            "only_verified_items_may_be_forwarded": {
              "const": true
            },
            "required_verification": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "unverified_candidates_forward_allowed": {
              "const": false
            }
          },
          "additionalProperties": false
        },
        "verified_items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pyqItem"
          }
        },
        "unverified_candidates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pyqItem"
          }
        },
        "question_patterns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/questionPattern"
          }
        }
      },
      "additionalProperties": false
    },
    "topicTestScoring": {
      "type": "object",
      "required": [
        "marks_per_question",
        "negative_marking_fraction",
        "wrong_answer_penalty",
        "multiple_mark_penalty",
        "blank_all_five_options_penalty",
        "explicit_not_attempted_option",
        "explicit_not_attempted_penalty",
        "formula"
      ],
      "properties": {
        "marks_per_question": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "negative_marking_fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "wrong_answer_penalty": {
          "type": "number",
          "minimum": 0
        },
        "multiple_mark_penalty": {
          "type": "number",
          "minimum": 0
        },
        "blank_all_five_options_penalty": {
          "type": "number",
          "minimum": 0
        },
        "explicit_not_attempted_option": {
          "const": "E"
        },
        "explicit_not_attempted_penalty": {
          "type": "number",
          "minimum": 0
        },
        "formula": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "testMcqItem": {
      "type": "object",
      "required": [
        "question_id",
        "question_no",
        "question",
        "options",
        "correct_option",
        "answer",
        "explanation",
        "source_status",
        "student_forwardable",
        "display_answer_after_submission"
      ],
      "properties": {
        "question_id": {
          "type": "string",
          "pattern": "^HIS-[0-9]{3}-MCQ-[0-9]{3}$"
        },
        "question_no": {
          "type": "integer",
          "minimum": 1
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "options": {
          "$ref": "#/$defs/options"
        },
        "correct_option": {
          "type": "string",
          "enum": [
            "A",
            "B",
            "C",
            "D"
          ]
        },
        "answer": {
          "type": "string",
          "minLength": 1
        },
        "explanation": {
          "type": "string",
          "minLength": 1
        },
        "explanation_status": {
          "type": "string"
        },
        "source_status": {
          "const": "author_created_practice_not_pyq"
        },
        "student_forwardable": {
          "const": true
        },
        "display_answer_after_submission": {
          "const": true
        }
      },
      "additionalProperties": false
    },
    "topicTestDocument": {
      "type": "object",
      "required": [
        "schema_version",
        "test_id",
        "topic_id",
        "topic_title",
        "language",
        "content_type",
        "exam_target",
        "question_count",
        "time_limit_minutes",
        "total_marks",
        "scoring",
        "answer_visibility",
        "source_status",
        "student_forwardable",
        "items",
        "response_options",
        "skip_option",
        "exam_rule_effective_date"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "test_id": {
          "type": "string"
        },
        "topic_id": {
          "type": "string",
          "pattern": "^HIS-[0-9]{3}$"
        },
        "topic_title": {
          "type": "string"
        },
        "language": {
          "const": "mr"
        },
        "content_type": {
          "const": "mpsc_topic_test"
        },
        "exam_target": {
          "type": "string"
        },
        "question_count": {
          "type": "integer",
          "minimum": 1
        },
        "time_limit_minutes": {
          "type": "integer",
          "minimum": 1
        },
        "total_marks": {
          "type": "number",
          "minimum": 1
        },
        "scoring": {
          "$ref": "#/$defs/topicTestScoring"
        },
        "answer_visibility": {
          "const": "after_submission"
        },
        "source_status": {
          "const": "author_created_practice_not_pyq"
        },
        "student_forwardable": {
          "const": true
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/testMcqItem"
          }
        },
        "response_options": {
          "const": [
            "A",
            "B",
            "C",
            "D",
            "E"
          ]
        },
        "skip_option": {
          "const": "E"
        },
        "exam_rule_effective_date": {
          "type": "string",
          "format": "date"
        }
      },
      "additionalProperties": false
    },
    "testQuestionReference": {
      "type": "object",
      "required": [
        "question_no",
        "question_id",
        "topic_id",
        "source_file"
      ],
      "properties": {
        "question_no": {
          "type": "integer",
          "minimum": 1
        },
        "question_id": {
          "type": "string",
          "pattern": "^HIS-[0-9]{3}-MCQ-[0-9]{3}$"
        },
        "topic_id": {
          "type": "string",
          "pattern": "^HIS-[0-9]{3}$"
        },
        "source_file": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "testSeriesItem": {
      "type": "object",
      "required": [
        "test_id",
        "title",
        "language",
        "exam_target",
        "test_type",
        "question_count",
        "time_limit_minutes",
        "total_marks",
        "scoring",
        "answer_visibility",
        "source_status",
        "student_forwardable",
        "questions",
        "response_options",
        "omr_rule_effective_date"
      ],
      "properties": {
        "test_id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "language": {
          "const": "mr"
        },
        "exam_target": {
          "type": "string"
        },
        "test_type": {
          "type": "string",
          "enum": [
            "history_sectional_test",
            "mixed_history_mock"
          ]
        },
        "question_count": {
          "type": "integer",
          "minimum": 1
        },
        "time_limit_minutes": {
          "type": "integer",
          "minimum": 1
        },
        "total_marks": {
          "type": "number",
          "minimum": 1
        },
        "scoring": {
          "$ref": "#/$defs/topicTestScoring"
        },
        "answer_visibility": {
          "const": "after_submission"
        },
        "source_status": {
          "const": "author_created_practice_not_pyq"
        },
        "student_forwardable": {
          "const": true
        },
        "questions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/testQuestionReference"
          }
        },
        "response_options": {
          "const": [
            "A",
            "B",
            "C",
            "D",
            "E"
          ]
        },
        "omr_rule_effective_date": {
          "type": "string",
          "format": "date"
        },
        "exam_profile": {
          "type": "string"
        },
        "question_resolution": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "testSeriesDocument": {
      "type": "object",
      "required": [
        "schema_version",
        "series_id",
        "series_title",
        "language",
        "exam_scope",
        "total_tests",
        "total_question_attempts",
        "question_banks",
        "delivery_policy",
        "tests"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "series_id": {
          "type": "string"
        },
        "series_title": {
          "type": "string"
        },
        "language": {
          "const": "mr"
        },
        "exam_scope": {
          "type": "string"
        },
        "total_tests": {
          "type": "integer",
          "minimum": 1
        },
        "total_question_attempts": {
          "type": "integer",
          "minimum": 1
        },
        "question_banks": {
          "type": "string"
        },
        "delivery_policy": {
          "type": "object"
        },
        "tests": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/testSeriesItem"
          }
        },
        "scoring_profile_note": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/mcqDocument"
    },
    {
      "$ref": "#/$defs/pyqDocument"
    },
    {
      "$ref": "#/$defs/topicTestDocument"
    },
    {
      "$ref": "#/$defs/testSeriesDocument"
    }
  ]
}
